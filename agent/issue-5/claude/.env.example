# Environment Configuration for Ollama-based Claude Agent
# Copy this file to .env and fill in your values

# Ollama server URL (default: http://localhost:11434)
ANTHROPIC_BASE_URL=http://localhost:11434

# API key (required by SDK but Ollama doesn't validate it)
ANTHROPIC_API_KEY=ollama

# Model to use (make sure it's installed: ollama pull <model>)
ANTHROPIC_MODEL=llama3.2

# Alternative models you can use:
# - llama3.2 (lightweight, good for general tasks)
# - llama3.1 (more capable, larger)
# - mistral (good balance of speed and quality)
# - qwen2.5 (strong reasoning capabilities)
# - gemma2 (Google's open model)
